# Kopieren nach .env und ausfüllen. Die .env wird nie committet.
# Key erstellen: csfloat.com -> Profil -> Tab "Developer"
# Ohne Key nutzt das Tool automatisch Skinport (funktioniert ohne Key).
CSFLOAT_API_KEY=

# Geschenk-Modus: 1 = Das Tool kauft auf CSFloat selbst, ohne Rückfrage
# (innerhalb der harten Limits). Nutzt einen inoffiziellen CSFloat-Endpunkt,
# siehe README. Bezahlt wird vom CSFloat-Guthaben.
CSFLOAT_AUTO_BUY=0

# Optional: wo Ledger und Cache liegen (Standard: ~/.cs2_rewards)
# REWARD_HOME=
